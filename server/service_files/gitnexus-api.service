[Unit]
Description=GitNexus API server (REST API + MCP StreamableHTTP)
After=network.target
Wants=network.target

[Service]
Type=simple
User=mike
WorkingDirectory=/home/mike/hosting/GitNexus
Environment="HOME=/home/mike"
Environment="GITNEXUS_LBUG_EXTENSION_INSTALL=auto"
# Binds loopback only; nginx exposes it at https://gitnexus.freno.me/api
ExecStart=/home/linuxbrew/.linuxbrew/Cellar/node/26.7.0/bin/node /home/mike/hosting/GitNexus/gitnexus/dist/cli/index.js serve --host 127.0.0.1 --port 4747
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
