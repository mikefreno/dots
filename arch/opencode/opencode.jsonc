{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "atlas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "on-atlas",
      "options": {
        "baseURL": "localhost:8123/v1"
        //"apiKey": "{file:~/.config/opencode/my.key}"
      },
      "models": {
        "Qwen3.6-27B":{
          "limit":{
            "context": 155000,
            "output": 100000
          },
          "modalities":{
            "input":  ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.6-35B-A3B":{
          "limit":{
            "context": 125000,
            "output": 100000
          },
          "modalities":{
            "input":  ["text", "image"],
            "output": ["text"]
          }
        },
        "Gemma4-31B-Opus":{
          "limit":{
            "context": 80000,
            "output": 100000
          },
          "modalities":{
            "input":  ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "hermes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "on-hermes",
      "options": {
        "baseURL": "hermes:8123/v1"
      },
      "models": {
        "Qwen3.5-9B": {
          "limit":{
            "context": 100000,
            "output": 100000
          }
        },
        "Qwen3.5-4B": {
          "limit":{
            "context": 150000,
            "output": 100000
          }
        }
      }
    },
    "strix": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "on-strix",
      "options": {
        "baseURL": "strix:8123/v1"
      },
      "models": {
        "Qwen3.6-27B":{
          "limit":{
            "context": 262144,
            "output": 100000
          },
          "modalities":{
            "input":  ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.6-35B-A3B": {
          "limit":{
            "context": 262144,
            "output": 100000
          },
          "modalities":{
            "input":  ["text", "image"],
            "output": ["text"]
          }
        },
        "MiniMax-M2.7": {
          "limit":{
            "context": 200000,
            "output": 100000
          }
        },
        "Qwen3.5-122B-A10B": {
          "limit":{
            "context": 262144,
            "output": 100000
          }
        },
        "Qwen3-Coder-Next": {
          "limit":{
            "context": 262144,
            "output": 100000
          }
        }
      }
    },
    "pan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "on-pan",
      "options": {
        "baseURL": "pan:8080/v1"
      },
      "models": {
        "preferred": {
          "limit":{
            "context": 262144,
            "output": 100000
          }
        }
      }
    }
  },
  "lsp": {
    "lua": {
      "command": [
        "lua-language-server"
      ],
      "extensions": [
        ".lua"
      ]
    }
  },
  "mcp": {
    "apple-docs-mcp": {
      "type": "local",
      "command": ["npx", "@kimsungwhee/apple-docs-mcp", "--help"],
      "enabled": true
    },
    "expo-docs": {
      "type": "local",
      "command": ["npx", "expo-docs-mcp"],
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.config/opencode/c7.key}"
      }
    },
    "alpha-vantage":{
      "type": "remote",
      "url": "https://mcp.alphavantage.co/mcp?apikey={file:~/.config/opencode/av.key}"
    }
    //"clerk": {
      //"type": "remote",
      //"url": "https://cursor.com/en-US/install-mcp?name=clerk&config=eyJ1cmwiOiJodHRwczovL21jcC5jbGVyay5jb20vbWNwIn0%3D",
    //}
  },
  "formatter": {
    "stylua": {
      "command": [
        "stylua",
        "--check",
        "$FILE"
      ],
      "extensions": [
        ".lua"
      ]
    }
  }
}
