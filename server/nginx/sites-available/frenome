    ssl_certificate_key /etc/letsencrypt/live/pen.freno.me/privkey.pem; # managed by Certbot
}

# ===================================================================
# SERVICE 11: Plane (Community Edition) — project management
#
#   Single origin -> the stack's bundled plane-proxy (Caddy) on 127.0.0.1:8092,
#   which routes internally: / -> web, /api + /auth -> Django API, /spaces ->
#   space, /god-mode -> admin, /live -> WebSocket server, /uploads -> MinIO.
#   Stack lives in /home/mike/hosting/plane (manage with `make up`).
#   Note: needs a cert first under /etc/letsencrypt/live/plane.freno.me.
#   Run: sudo certbot --nginx -d plane.freno.me   (before nginx -t will pass)
# ===================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name plane.freno.me;

    # Plane caps uploads at 5 MB by default (FILE_SIZE_LIMIT in plane.env).
    client_max_body_size 10m;

    # plane-ntfy-bridge: signed webhook POSTs from Plane (must be matched
    # BEFORE the / catch-all that goes to plane-proxy)
    location /webhooks/ntfy {
        proxy_pass http://127.0.0.1:8094;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:8092;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # WebSockets (/live/*) — $connection_upgrade is in conf.d/websocket.conf
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Long-lived websocket / streaming connections
        proxy_read_timeout 3600;
        proxy_connect_timeout 60;
        proxy_send_timeout 3600;
        send_timeout 3600;

        proxy_buffering off;
    }

    ssl_certificate /etc/letsencrypt/live/plane.freno.me/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/plane.freno.me/privkey.pem; # managed by Certbot
}
