#!/bin/bash

# ─── Multi Display Config ───────────────────────────────────────────────
# Built-in display: main + optional hermes. External display: web, comms +
# optional add/emulators. Each display's space count is set on that display
# and labeled by position, so no space ever has to be moved between
# displays (space --display is broken on this build).
# Sourced by yabairc when two or more displays are attached.

d1=$(yabai -m query --displays | jq '.[0].index')   # built-in
d2=$(yabai -m query --displays | jq '.[1].index')   # external

builtin_needed=1
has_hermes && builtin_needed=$((builtin_needed + 1))

external_needed=2                                   # web, comms
has_extra_apps         && external_needed=$((external_needed + 1))
has_multiple_emulators && external_needed=$((external_needed + 1))

adjust_space_count "$d1" "$builtin_needed"
adjust_space_count "$d2" "$external_needed"

label_space "$d1" 1 main
has_hermes && label_space "$d1" 2 hermes

label_space "$d2" 1 web
label_space "$d2" 2 comms
has_extra_apps         && label_space "$d2" 3 add
has_multiple_emulators && label_space "$d2" 4 emulators

# Shared rules + config
source "$(dirname "$0")/yabairc-common"
