#!/bin/bash

# ─── Multi Display Config ───────────────────────────────────────────────
# Order matches single-display mode: main, web, comms, [add], [emulators].
# Labeling by position is deterministic at yabai startup; the shared
# rules then route apps. Built-in keeps only main (terminal); the
# external display gets the rest.
# Sourced by yabairc (the dispatcher) when two or more displays are attached.

needed=3
has_extra_apps && needed=$((needed + 1))
has_emulator   && needed=$((needed + 1))
adjust_space_count "$needed"

yabai -m space 1 --label main
yabai -m space 2 --label web
yabai -m space 3 --label comms
if has_extra_apps; then
    yabai -m space 4 --label add
fi
if has_emulator; then
    yabai -m space 5 --label emulators
fi

# Place displays by label — indexes shift as moves happen, so re-query
# each label right before moving it, and only move what is misplaced.
d1=$(yabai -m query --displays | jq '.[0].index')   # built-in
d2=$(yabai -m query --displays | jq '.[1].index')   # external

move_label_to_display main  "$d1"
move_label_to_display web   "$d2"
move_label_to_display comms "$d2"
has_extra_apps && move_label_to_display add   "$d2"
has_emulator && move_label_to_display emulators "$d2"

# Shared rules + config
source "$(dirname "$0")/yabairc-common"
