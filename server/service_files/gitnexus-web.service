[Unit]
Description=GitNexus Web UI (static + backend URL injection)
After=network.target
Wants=network.target

[Service]
Type=simple
User=mike
WorkingDirectory=/home/mike/hosting/GitNexus/gitnexus-web
Environment="HOME=/home/mike"
Environment="PORT=4173"
# Same-origin backend URL; nginx routes /api/* to gitnexus-api (127.0.0.1:4747)
Environment="GITNEXUS_BACKEND_URL=https://gitnexus.freno.me"
# API/MCP Bearer-token gate (docker-server enforces this on every /api/* request,
# then proxies to gitnexus-api on 4747). Rotate with: openssl rand -hex 24
Environment="GITNEXUS_UPSTREAM_URL=http://127.0.0.1:4747"
# API/MCP Bearer token lives OUTSIDE the repo (github-mirrored) in
# /home/mike/.config/gitnexus-web.env (0600). See server/nginx/creds.md.
EnvironmentFile=/home/mike/.config/gitnexus-web.env
ExecStart=/home/linuxbrew/.linuxbrew/Cellar/node/26.7.0/bin/node /home/mike/hosting/GitNexus/docker-server.mjs
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
