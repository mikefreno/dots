# ===================================================================
# HTTP to HTTPS Redirect for ALL domains
# ===================================================================
server {
    listen 80;
    server_name jellyfin.freno.me michaelfreno.asuscomm.com vw.freno.me git.freno.me next.freno.me paper.freno.me odysseus.freno.me pen.freno.me gitnexus.freno.me macro.freno.me nook-relay.freno.me;

    return 301 https://$host$request_uri;
}

# ===================================================================
# SERVICE 1: Jellyfin Media Server
# ===================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name jellyfin.freno.me;

    ssl_certificate /etc/letsencrypt/live/jellyfin.freno.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jellyfin.freno.me/privkey.pem;

    client_max_body_size 10G;

    location / {
        proxy_pass http://127.0.0.1:8096;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}

