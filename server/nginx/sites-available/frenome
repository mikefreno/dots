# ===================================================================
# HTTP to HTTPS Redirect for ALL domains
# ===================================================================
server {
    listen 80;
    server_name jellyfin.freno.me michaelfreno.asuscomm.com vw.freno.me git.freno.me next.freno.me odysseus.freno.me pen.freno.me nook-relay.freno.me plane.freno.me pihole.freno.me kuma.freno.me ntfy.freno.me glance.freno.me beszel.freno.me audiobookshelf.freno.me miniflux.freno.me;

    # certbot webroot challenge — must be served over plain HTTP, no redirect.
    # NB: the redirect MUST live in a location, not at server level — a
    # server-level `return` runs in the rewrite phase BEFORE location
    # matching and would 301 the ACME challenges away.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ===================================================================
# SERVICE 12: Pi-hole admin — upstream 127.0.0.1:8080
#
#   Publicly reachable (nginx is internet-facing) — protection is
#   Pi-hole's own login. Deliberately NO IP allowlist: freno.me names
#   resolve to the WAN IP, so remote access arrives from arbitrary
#   public IPs (tailnet source IPs only appear when using ts.net
#   hostnames, which nothing here does).
# ===================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name pihole.freno.me;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Single multi-SAN lineage covers all three new services (issued as one
    # cert by install.sh — see certbot output)
    ssl_certificate /etc/letsencrypt/live/pihole.freno.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pihole.freno.me/privkey.pem;
}

