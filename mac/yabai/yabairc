#!/bin/bash

# ─── Bootstrap ──────────────────────────────────────────────────────────

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa &>/dev/null

display_count=$(yabai -m query --displays | jq length)
echo "Number of displays detected: $display_count"

# ─── Helpers ────────────────────────────────────────────────────────────

running()              { pgrep -x "$1" >/dev/null; }
has_blender_or_bambu() { running "Blender" || running "BambuStudio"; }
has_obsidian()         { running "Obsidian"; }
has_slack()            { running "Slack"; }
has_emulator()         { running "Simulator" || pgrep "qemu-system-aarch64" >/dev/null; }
has_extra_apps()       { has_blender_or_bambu || has_obsidian || has_slack; }

get_space_count() { yabai -m query --spaces | jq length; }

adjust_space_count() {
    local needed=$1 current
    current=$(get_space_count)
    while [ "$current" -lt "$needed" ]; do
        yabai -m space --create
        current=$((current + 1))
    done
    while [ "$current" -gt "$needed" ]; do
        yabai -m space "$current" --destroy
        current=$((current - 1))
    done
}

# ─── BSP Insertion for "add" Space ──────────────────────────────────────
# When a Blender/Bambu/Omni/Slack window opens in the add space, insert it
# so Blender+Bambu share the west side and Obsidian+Slack share the east.

yabai -m signal --add event=window_created action="
    app=\$(/opt/homebrew/bin/yabai -m query --windows --window \$YABAI_WINDOW_ID 2>/dev/null | \
          /opt/homebrew/bin/jq -r '.app // empty')
    case \"\$app\" in
        Blender|Bambu\ Studio)
            space_idx=\$(/opt/homebrew/bin/yabai -m query --windows --window \$YABAI_WINDOW_ID 2>/dev/null | \
                        /opt/homebrew/bin/jq -r '.space // empty')
            if [ -n \"\$space_idx\" ]; then
                label=\$(/opt/homebrew/bin/yabai -m query --spaces --space \"\$space_idx\" 2>/dev/null | \
                        /opt/homebrew/bin/jq -r '.label // empty')
                if [ \"\$label\" = \"add\" ]; then
                    /opt/homebrew/bin/yabai -m window \$YABAI_WINDOW_ID --insert west 2>/dev/null
                fi
            fi
            ;;
        Obsidian|Slack)
            space_idx=\$(/opt/homebrew/bin/yabai -m query --windows --window \$YABAI_WINDOW_ID 2>/dev/null | \
                        /opt/homebrew/bin/jq -r '.space // empty')
            if [ -n \"\$space_idx\" ]; then
                label=\$(/opt/homebrew/bin/yabai -m query --spaces --space \"\$space_idx\" 2>/dev/null | \
                        /opt/homebrew/bin/jq -r '.label // empty')
                if [ \"\$label\" = \"add\" ]; then
                    /opt/homebrew/bin/yabai -m window \$YABAI_WINDOW_ID --insert east 2>/dev/null
                fi
            fi
            ;;
    esac
" 2>/dev/null

# ─── Space Layout ───────────────────────────────────────────────────────

setup_spaces() {
    local needed

    if [ "$display_count" -eq 1 ]; then
        # Single display: main, web, comms + optional add
        needed=3
        has_extra_apps && needed=4
        adjust_space_count "$needed"

        yabai -m space 1 --label main
        yabai -m space 2 --label web
        yabai -m space 3 --label comms
        if has_extra_apps; then
            yabai -m space 4 --label add
        fi
    else
        # Multi-display: [add], main, web, comms, [emulators]
        needed=3
        has_extra_apps && needed=$((needed + 1))
        has_emulator   && needed=$((needed + 1))
        adjust_space_count "$needed"

        # Label all spaces first
        local idx=1
        if has_extra_apps; then
            yabai -m space $idx --label add
            idx=$((idx + 1))
        fi
        yabai -m space $idx --label main
        idx=$((idx + 1))
        yabai -m space $idx --label web
        idx=$((idx + 1))
        yabai -m space $idx --label comms
        idx=$((idx + 1))
        if has_emulator; then
            yabai -m space $idx --label emulators
        fi

        # Assign to displays
        local d1 d2
        d1=$(yabai -m query --displays | jq '.[0].index')   # built-in
        d2=$(yabai -m query --displays | jq '.[1].index')   # external

        idx=1
        # Display 1 (built-in): [add], main
        if has_extra_apps; then
            yabai -m space $idx --display "$d1"
            idx=$((idx + 1))
        fi
        yabai -m space $idx --display "$d1"
        idx=$((idx + 1))
        # Display 2 (external): web, comms, [emulators]
        while [ "$idx" -le "$needed" ]; do
            yabai -m space $idx --display "$d2"
            idx=$((idx + 1))
        done
    fi
}

# ─── Window Rules ───────────────────────────────────────────────────────

setup_rules() {
    yabai -m rule --remove ".*" 2>/dev/null

    # Core spaces (always present)
    yabai -m rule --add app="^(Alacritty|kitty|Ghostty)$"                        space="main"
    yabai -m rule --add app="^Xcode(-beta)?$"                                     space="main"
    yabai -m rule --add app="^(Orion|Safari|Brave Browser|SigmaOS|Zen Browser|Zen)$" space="web"
    yabai -m rule --add app="^(Mail|Messages|Things|Telegram)$"                   space="comms"

    # Extra apps → merged "add" space
    # (Rules are always registered so they apply even if apps launch later)
    yabai -m rule --add app="^(Blender|Bambu Studio|Obsidian|Slack|Epic Games Launcher|UnrealEditor)$"             space="add"

    # Emulators
    if [ "$display_count" -eq 1 ] || ! has_emulator; then
        yabai -m rule --add app="^(Simulator|Android Emulator|qemu-system-aarch64)$" space="main" manage=on
    else
        yabai -m rule --add app="^(Simulator|Android Emulator|qemu-system-aarch64)$" space="emulators" manage=on
    fi

    # Floating / special windows
    yabai -m rule --add title="^Ubuntu$"                                           space="main" manage=off
    yabai -m rule --add title="^(Preview|Preferences|Settings|Control Center|Steam|Gaze|Simulator)$" manage=off
    yabai -m rule --add app="^(Calculator|System Preferences|System Settings|Activity Monitor|Archive Utility|Finder|Notes|Numi|Weather|DaisyDisk|Raycast|Raycast Settings|Dato|Terminal|Proton VPN|iStat Menus|Transmission|AlDente|Steam|Little Snitch|Radio Silence|TextEdit|love|Bitwarden|App Store|Gaze|Simulator)$" manage=off

    # Apply all rules retroactively
    yabai -m rule --apply
}

# ─── Display-Change Watcher ─────────────────────────────────────────────

yabai -m signal --add event=display_added action="$0"
yabai -m signal --add event=display_removed action="$0"

# ─── Main ───────────────────────────────────────────────────────────────

setup_spaces
setup_rules

# General yabai config
yabai -m config \
    layout                 bsp            \
    top_padding            10             \
    bottom_padding         10             \
    left_padding           10             \
    right_padding          10             \
    window_gap             16             \
    window_shadow          float          \
    mouse_modifier         cmd            \
    mouse_action1          move           \
    mouse_action2          resize         \
    external_bar           all:40:0

# Window borders (JankyBorders)
borders

echo "yabai configuration loaded successfully"
