#!/bin/bash

# ─── Single Display Config ──────────────────────────────────────────────
# All spaces live on the one display: main, web, comms + optional
# add. Labeling is by position (deterministic at yabai startup); the
# shared rules then route apps. Hermes gets no space here — it floats (see
# yabairc-common). Sourced by yabairc when exactly one display is attached.

needed=3
has_extra_apps && needed=$((needed + 1))
adjust_space_count "$needed"

reset_space_counter
label_space main
label_space web
label_space comms
has_extra_apps && label_space add

# Shared rules + config
source "$(dirname "$0")/yabairc-common"
