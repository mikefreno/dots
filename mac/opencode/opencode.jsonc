{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "atlas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "on-atlas",
      "options": {
        "baseURL": "https://infill.freno.me/v1",
        "apiKey": "{file:~/.config/opencode/my.key}",
      },
      "models": {
        "unsloth/glm-4.7-flash": {
          "limit":{
            "context": 125000,
            "output": 100000
          }
        },
        "unsloth/qwen3.5-fast":{
          "limit":{
            "context": 115000,
            "output": 100000
          },
          "modalities":{
            "input":  ["text", "image"],
            "output": ["text"]
          }
        },
        "unsloth/qwen3.5":{
          "limit":{
            "context": 115000,
            "output": 100000
          },
          "modalities":{
            "input":  ["text", "image"],
            "output": ["text"]
          }
        },
      }
    },
    "hermes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "on-hermes",
      "options": {
        "baseURL": "https://100.91.119.16:1234/v1",
      },
      "models": {
        "unsloth/Qwen3.5-9B-GGUF": {
          "limit":{
            "context": 30000,
            "output": 100000
          }
        }
      }
    },
    "pan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "on-pan",
      "options": {
        "baseURL": "https://100.68.170.49/v1",
      },
      "models": {
        "unsloth/Qwen3.5-4B-GGUF": {
          "limit":{
            "context": 262000,
            "output": 100000
          }
        }
      }
    }
  },
  "lsp": {
    "lua": {
      "command": [
        "lua-language-server"
      ],
      "extensions": [
        ".lua"
      ]
    }
  },
  "mcp": {
    "apple-docs-mcp": {
      "type": "local",
      "command": ["npx", "@kimsungwhee/apple-docs-mcp", "--help"],
      "enabled": true,
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.config/opencode/c7.key}"
      }
    },
    "alpha-vantage":{
      "type": "remote",
      "url": "https://mcp.alphavantage.co/mcp?apikey={file:~/.config/opencode/av.key}"
    },
    //"clerk": {
      //"type": "remote",
      //"url": "https://cursor.com/en-US/install-mcp?name=clerk&config=eyJ1cmwiOiJodHRwczovL21jcC5jbGVyay5jb20vbWNwIn0%3D",
    //}
  },
  "formatter": {
    "stylua": {
      "command": [
        "stylua",
        "--check",
        "$FILE"
      ],
      "extensions": [
        ".lua"
      ]
    }
  }
}
